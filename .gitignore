# --- OS Junk ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.iml
*.swp
*.bak

# --- Logs & Temps ---
*.log
*.tmp

# --- Backend (Spring Boot / Maven) ---
**/target/
**/.mvn/
# Note: mvnw and mvnw.cmd are intentionally tracked for portable builds

# --- Frontend (Angular / Node) ---
**/node_modules/
**/dist/
**/.angular/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# --- Environments & Secrets ---
**/.env
**/.env.*
!**/.env.example
infra/*.tfvars
infra/*.tfvars.json

# --- Infrastructure (Terraform) ---
**/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfstate
infra/terraform.tfstate.backup

# --- GCP / Cloud Build ---
cloudbuild-logs.txt
# Note: .gcloudignore is intentionally tracked to maintain build consistency
